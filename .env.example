# Port HTTP du serveur Node.js
PORT=4000

# Facultatif mais recommandé sur un réseau partagé.
# La même valeur doit être utilisée par MONITOR_TOKEN côté agent Java.
MONITOR_TOKEN=change-me

# Nombre maximal de mesures gardées par machine en mémoire.
HISTORY_LIMIT=900

# Une machine est considérée hors ligne après ce délai.
AGENT_OFFLINE_MS=15000

# URL autorisée pour le dashboard en développement.
CORS_ORIGIN=http://localhost:5173

